{
  "name": "secop-intelligence",
  "version": "0.1.0",
  "description": "Sistema de Inteligencia de Oportunidades SECOP para Foton Colombia — reto IA-Hackathon GOV-TECH de Croma",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
