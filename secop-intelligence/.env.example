# Croma API — obtén tu key en https://usecroma.com ("Get API key")
CROMA_API_KEY=

# Base URL de la API de Croma (por defecto la de producción)
CROMA_BASE_URL=https://api.croma.run

# Puerto del servidor Express
PORT=8095

# Límite de llamadas a Croma por minuto (brief: no > 10/min)
CROMA_MAX_CALLS_PER_MIN=10

# TTL del caché en horas (para no reconsultar procesos ya vistos)
CACHE_TTL_HOURS=6
