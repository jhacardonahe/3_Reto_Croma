# Croma API — obtén tu key en https://usecroma.com ("Get API key")
CROMA_API_KEY=

# Base URL de la API de Croma (por defecto la de producción)
CROMA_BASE_URL=https://api.croma.run

# Puerto del servidor Express
PORT=8096

# Límite de llamadas a Croma por minuto (brief: no > 10/min)
CROMA_MAX_CALLS_PER_MIN=10

# TTL del caché en horas (para no reconsultar procesos ya vistos)
CACHE_TTL_HOURS=6

# Key de respaldo de Croma — failover automático cuando la primaria devuelve 429
CROMA_API_KEY_BACKUP=

# Anthropic (Claude) — para generar taxonomías de categorías desde una descripción del negocio.
# Consíguela en https://console.anthropic.com. Opcional: sin ella, el sistema usa el preset fijo.
ANTHROPIC_API_KEY=
# Modelo de Claude para la generación (por defecto el más capaz)
CLAUDE_MODEL=claude-opus-4-8
