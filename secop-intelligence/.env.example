# Croma API — obtén tu key en https://usecroma.com ("Get API key")
CROMA_API_KEY=

# Base URL de la API de Croma (por defecto la de producción)
CROMA_BASE_URL=https://api.croma.run

# Puerto del servidor Express
PORT=8096

# Límite de llamadas a Croma por minuto (brief: no > 10/min)
CROMA_MAX_CALLS_PER_MIN=10

# TTL del caché en horas (para no reconsultar procesos ya vistos)
CACHE_TTL_HOURS=6

# --- Agente vivo (latido + Telegram) ------------------------------------------
# Token del bot: @BotFather → /newbot. NUNCA lo subas al repo.
TELEGRAM_BOT_TOKEN=
# Chat destino: escribe algo a tu bot y mira
#   https://api.telegram.org/bot<TOKEN>/getUpdates  →  result[0].message.chat.id
# (para un grupo, agrega el bot al grupo y usa el id negativo que aparezca ahí)
TELEGRAM_CHAT_ID=

# URL pública del tablero (botón "Abrir tablero" del mensaje). Vacío ⇒ sin botón.
PUBLIC_BASE_URL=

# Sobre del barrido programado (npm run sweep). Valores por defecto conservadores:
# 3 latidos/día con este tope caben de sobra en el Default Bucket de Croma.
SWEEP_WINDOW_DAYS=7
SWEEP_MAX_DETAIL=40
SWEEP_CONCURRENCY=3
SWEEP_MIN_SCORE=40
SWEEP_DIGEST_LIMIT=5
